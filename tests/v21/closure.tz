# closures: lambdas that capture locals (by value; the closure keeps its own copy)
kattamaipu Btn { label: string; on_click: Fn<(int): int>; }

seyal make_adder(n: int): Fn<(int): int> {
    kudu seyal(x: int): int { kudu x + n; };
}
seyal make_counter(): Fn<(): int> {
    edu count = 0;
    kudu seyal(): int { count += 1; kudu count; };
}
seyal twice(f: Fn<(int): int>, v: int): int { kudu f(f(v)); }
seyal plain(x: int): int { kudu x * 10; }

seyal main(): int {
    edu add5 = make_adder(5);
    edu add7 = make_adder(7);
    pathi("%d %d\n", add5(1), add7(1));
    pathi("%d\n", twice(add5, 0));

    edu c1 = make_counter();
    edu c2 = make_counter();
    c1(); c1();
    pathi("%d %d\n", c1(), c2());

    edu base = 100;
    edu total = 0;
    edu bump = seyal(d: int): int { total += d; kudu base + total; };
    edu r1 = bump(1);
    edu r2 = bump(2);
    pathi("%d %d\n", r1, r2);
    pathi("%d\n", total);                       # captured by value: the outer copy is unchanged

    pathi("%d\n", twice(plain, 1));             # plain functions convert to Fn
    pathi("%d\n", twice(seyal(x: int): int { kudu x - 1; }, 10));   # non-capturing lambda too

    # nested capture: inner lambda uses a variable of the outermost function
    edu k = 3;
    edu outer = seyal(a: int): int {
        edu inner = seyal(b: int): int { kudu a * b + k; };
        kudu inner(4);
    };
    pathi("%d\n", outer(2));

    edu b = Btn { label: "ok", on_click: add5 };
    pathi("%s %d\n", b.label, b.on_click(1));

    edu fs = puthu List<Fn<(int): int>>(add5, add7, plain);
    edu sum = 0;
    ovvoru (edu f ulle fs) { sum += f(1); }
    pathi("%d\n", sum);
    kudu 0;
}
