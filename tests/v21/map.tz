# Map<K,V>, Set<T>
pattiyal Color { Red, Green, Blue }
seyal main(): int {
    edu ages = puthu Map<string, int>();
    ages.put("asha", 31);
    ages["ravi"] = 27;
    ages["asha"] += 1;
    ages["new"] += 5;
    pathi("%d %d %d %d\n", ages["asha"], ages["ravi"], ages.get_or("zed", -1), ages.length);
    pathi("%d %d\n", ages.has("ravi"), ages.has("nobody"));
    ovvoru (edu k ulle ages) { pathi("%s=%d ", k, ages[k]); }
    pathi("\n");
    edu r1 = ages.remove("ravi");
    edu r2 = ages.remove("ravi");
    pathi("%d %d\n", r1, r2);
    edu ks = ages.keys();
    edu vs = ages.values();
    pathi("%d %s %d\n", ks.length, ks[1], vs[0]);

    # many entries force the table to grow and rehash
    edu big = puthu Map<int, int>();
    ovvoru (edu i ulle 0 .. 1000) { big[i * 7] = i; }
    edu sum = 0;
    ovvoru (edu i ulle 0 .. 1000) { sum += big[i * 7]; }
    pathi("%d %d\n", big.length, sum);
    ovvoru (edu i ulle 0 .. 500) { big.remove(i * 7); }
    pathi("%d %d\n", big.length, big.has(7 * 600));

    edu seen = puthu Set<int>(3, 1, 3, 2);
    edu a1 = seen.add(1);
    edu a2 = seen.add(9);
    pathi("%d %d %d\n", seen.length, a1, a2);
    edu words = puthu Set<string>();
    ovvoru (edu w ulle puthu List<string>("a", "b", "a", "c", "b")) { words.add(w); }
    pathi("%d ", words.length);
    ovvoru (edu w ulle words) { pathi("%s", w); }
    pathi("\n");
    edu byColor = puthu Map<Color, string>();
    byColor[Color.Green] = "green";
    pathi("%s\n", byColor[Color.Green]);
    edu nested = puthu Map<string, List<int>>();
    nested["a"] = puthu List<int>(1, 2);
    nested["a"].push(3);
    pathi("%d\n", nested["a"].length);
    muyarchi { pathi("%d\n", ages["missing"]); } pidi (e) { pathi("caught: %s\n", e); }
    kudu 0;
}
