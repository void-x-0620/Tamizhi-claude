# nool/math.tzb — Tamizhi standard library: math functions
veli "tz_std.h";
veli seyal sqrt  = tz_sqrt(x : float) : float;
veli seyal pow   = tz_pow(x : float, y : float) : float;
veli seyal sin   = tz_sin(x : float) : float;
veli seyal cos   = tz_cos(x : float) : float;
veli seyal tan   = tz_tan(x : float) : float;
veli seyal log   = tz_log(x : float) : float;
veli seyal exp   = tz_exp(x : float) : float;
veli seyal floor = tz_floor(x : float) : float;
veli seyal ceil  = tz_ceil(x : float) : float;
veli seyal round = tz_round(x : float) : float;
veli seyal fabs  = tz_fabs(x : float) : float;
veli seyal abs   = tz_abs(x : int) : int;
veli seyal min   = tz_min(a : int, b : int) : int;
veli seyal max   = tz_max(a : int, b : int) : int;
veli seyal pi    = tz_pi() : float;
veli seyal asin  = tz_asin(x : float) : float;
veli seyal acos  = tz_acos(x : float) : float;
veli seyal atan  = tz_atan(x : float) : float;
veli seyal atan2 = tz_atan2(y : float, x : float) : float;
veli seyal sinh  = tz_sinh(x : float) : float;
veli seyal cosh  = tz_cosh(x : float) : float;
veli seyal tanh  = tz_tanh(x : float) : float;
veli seyal log10 = tz_log10(x : float) : float;
veli seyal log2  = tz_log2(x : float) : float;
veli seyal hypot = tz_hypot(x : float, y : float) : float;
veli seyal trunc = tz_trunc(x : float) : float;
veli seyal fmod  = tz_fmod(x : float, y : float) : float;
veli seyal cbrt  = tz_cbrt(x : float) : float;
veli seyal euler = tz_e() : float;
veli seyal inf   = tz_inf() : float;
veli seyal is_nan = tz_is_nan(x : float) : int;
veli seyal deg_to_rad = tz_deg_to_rad(d : float) : float;
veli seyal rad_to_deg = tz_rad_to_deg(r : float) : float;
veli seyal minf  = tz_minf(a : float, b : float) : float;
veli seyal maxf  = tz_maxf(a : float, b : float) : float;
veli seyal clamp  = tz_clamp(v : int, lo : int, hi : int) : int;
veli seyal clampf = tz_clampf(v : float, lo : float, hi : float) : float;
veli seyal sign  = tz_sign(v : int) : int;
veli seyal gcd   = tz_gcd(a : int, b : int) : int;
veli seyal lcm   = tz_lcm(a : int, b : int) : int;
veli seyal ipow  = tz_ipow(base : int, exp : int) : int;
veli seyal factorial = tz_factorial(n : int) : int;                  # n up to 20
veli seyal is_prime  = tz_is_prime(n : int) : int;
